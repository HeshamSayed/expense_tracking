# MoneyGuard Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production-use-long-random-string

# Environment (development, production, test)
ENVIRONMENT=development
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL connection (individual settings)
DB_NAME=moneyguard
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# OR use DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# REDIS & CACHE
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CELERY SETTINGS
# =============================================================================

# Use eager mode for synchronous task execution in development
CELERY_EAGER=False

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Allowed origins for CORS (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# =============================================================================
# EMAIL SETTINGS
# =============================================================================

# Email backend (console for dev, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@moneyguard.com

# Admin email for error notifications
ADMIN_EMAIL=admin@moneyguard.com

# =============================================================================
# STRIPE SETTINGS
# =============================================================================

# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe webhook signing secret (from webhook settings)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Pro subscription price ID (from Products page)
STRIPE_PRO_PRICE_ID=price_your_price_id_here

# =============================================================================
# SENTRY MONITORING (OPTIONAL)
# =============================================================================

# Sentry DSN for error tracking (optional, leave empty to disable)
SENTRY_DSN=

# =============================================================================
# FILE STORAGE (PRODUCTION)
# =============================================================================

# Static files URL (use CDN in production)
STATIC_URL=/static/
MEDIA_URL=/media/

# AWS S3 settings (optional, for production file storage)
# Uncomment and configure if using S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# FRONTEND URL
# =============================================================================

# Frontend URL for password reset links, etc.
FRONTEND_URL=http://localhost:3000

# =============================================================================
# SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Set these in production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# GOOGLE PLAY & APPLE APP STORE (MOBILE)
# =============================================================================

# Google Play service account JSON path (for in-app purchase verification)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Apple App Store shared secret (for in-app purchase verification)
APPLE_APP_STORE_SHARED_SECRET=

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
